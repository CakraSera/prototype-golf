{
  "name": "prototype-golf",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @golf/api --filter @golf/mobile dev",
    "dev:api": "pnpm --filter @golf/api dev",
    "dev:mobile": "pnpm --filter @golf/mobile dev",
    "typecheck": "pnpm -r typecheck"
  }
}
