# Copy to .env for local development: cp .env.example .env
# Local-only credentials; do not use these outside development.
POSTGRES_USER=golf
POSTGRES_PASSWORD=golf
POSTGRES_DB=prototype-golf
# Expanded by dotenv-cli when the API scripts load this file.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
NODE_ENV=development
